{
  "name": "tracescope-wasm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "vite --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "build:web": "npm run typecheck && vite build --config web/vite.config.ts",
    "build": "npm run build:wasm && npm run build:web",
    "preview": "vite preview --config web/vite.config.ts --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:wasm": "node --test tests/wasm-runtime.test.mjs",
    "test:rust": "cargo test --manifest-path engine/Cargo.toml",
    "bench:wasm": "node scripts/benchmark-wasm.mjs",
    "bench:browser": "node scripts/benchmark-browser.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wasm-pack": "0.15.0"
  }
}
